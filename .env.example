# ==============================================================================
# AURA REAL ESTATE - MÔI TRƯỜNG CẤU HÌNH HỆ THỐNG (.env.example)
# ==============================================================================
# Hướng dẫn: Tạo bản sao tệp này thành .env ở thư mục gốc và điền các giá trị thực tế:
#   cp .env.example .env
# Đối với Backend riêng biệt (nếu chạy local dev không qua Docker):
#   cp .env.example backend/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH APACHE AIRFLOW & MẬT MÃ HÓA (Bắt buộc cho Docker Compose)
# ------------------------------------------------------------------------------
# Khóa Fernet 32 byte url-safe base64 để mã hóa kết nối và biến bảo mật trong Airflow.
# Tạo bằng lệnh Python: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=your_fernet_key_here_32_bytes_base64=

# Khóa bí mật cho Flask Webserver session
AIRFLOW_WEBSERVER_SECRET_KEY=your_airflow_super_secret_webserver_key_here

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH THÔNG BÁO GMAIL SMTP (Tùy chọn - Dùng cho Airflow & Multi-Agent Alert)
# ------------------------------------------------------------------------------
# Tài khoản Gmail gửi báo cáo và cảnh báo tự động
AIRFLOW_SMTP_USER=your_email@gmail.com

# Mật khẩu ứng dụng Google (Google App Password 16 ký tự, KHÔNG phải mật khẩu tài khoản Gmail)
AIRFLOW_SMTP_PASSWORD=your_16_character_app_password

# Địa chỉ hiển thị người gửi
AIRFLOW_SMTP_MAIL_FROM=your_email@gmail.com

# Địa chỉ người nhận báo cáo thẩm định MLOps PDF & yêu cầu phê duyệt
ALERT_RECIPIENT=admin_recipient@gmail.com

# ------------------------------------------------------------------------------
# 3. ĐIỀU KHIỂN PIPELINE & AN TOÀN THU THẬP DỮ LIỆU (CRAWLER GUARD)
# ------------------------------------------------------------------------------
# Giờ kích hoạt chu trình MLOps hàng ngày (định dạng HH:MM, ví dụ 13:50 hoặc 02:00).
# Đặt 'none' nếu muốn tắt chế độ tự động và chỉ kích hoạt thủ công qua CLI hoặc API.
PIPELINE_RUN_TIME=none

# Số lượng tin bất động sản tối đa cào mỗi ngày (để tránh bị chặn IP/rate limit)
CRAWL_MAX_LIMIT=50

# ------------------------------------------------------------------------------
# 4. HUGGING FACE & vLLM INFERENCE SERVING (LLM CỤC BỘ)
# ------------------------------------------------------------------------------
# Hugging Face Access Token để tải model AWQ/Instruct nếu repository yêu cầu quyền truy cập
HF_TOKEN=

# Địa chỉ endpoint của máy chủ vLLM phục vụ mô hình Qwen2.5-3B-Instruct-AWQ
# Mặc định trong Docker network là http://vllm:8000/v1, nếu chạy máy chủ ngoài/host: http://localhost:8002/v1
VLLM_BASE_URL=http://vllm:8000/v1
VLLM_MODEL_NAME=Qwen/Qwen2.5-3B-Instruct-AWQ
VLLM_API_KEY=none_required

# ------------------------------------------------------------------------------
# 5. GOOGLE GEMINI API (DỰ PHÒNG CHO RAG CHATBOT & LANGFUSE TRACING)
# ------------------------------------------------------------------------------
# API Key của Google AI Studio (fallback khi LLM vLLM cục bộ không khả dụng hoặc quá tải)
GEMINI_API_KEY=your_gemini_api_key_here

# Langfuse LLM Observability & Tracing (Tùy chọn)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ------------------------------------------------------------------------------
# 6. CƠ SỞ DỮ LIỆU POSTGRESQL & VECTOR DATABASE CHROMADB
# ------------------------------------------------------------------------------
# Chuỗi kết nối PostgreSQL phục vụ bộ nhớ 2 tầng của Chatbot (2-tier memory)
# Trong mạng Docker: postgresql://postgres:postgres@postgres:5432/aura_realestate_db
# Khi chạy cục bộ trên máy host: postgresql://postgres:postgres@localhost:5432/aura_realestate_db
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/aura_realestate_db

# Địa chỉ kết nối ChromaDB Vector Database
CHROMA_HOST=chromadb
CHROMA_PORT=8000
