# Sử dụng base image Python 3.10
FROM python:3.10-slim-bullseye

# Thiết lập thư mục làm việc trong container
WORKDIR /app

# Biến môi trường giúp Python in log ra terminal ngay lập tức (không bị buffer)
ENV PYTHONUNBUFFERED=1

# Cài đặt các gói hệ thống cơ bản cần thiết cho việc crawl dữ liệu (Playwright/Selenium)
RUN apt-get update && apt-get install -y \
    wget curl gnupg libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Copy file requirements vào container
COPY requirements.txt .

# 1. Cài đặt PyTorch chuẩn (Bản CPU để tránh nặng máy, nếu máy server có GPU NVIDIA thì đổi link URL index)
RUN pip install --no-cache-dir torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu

# 2. Cài đặt các thư viện trong requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# 3. Cài đặt thêm các thư viện ML/VectorDB bị thiếu trong requirements (Scikit-learn, ChromaDB, Sentence-Transformers)
RUN pip install --no-cache-dir scikit-learn==1.4.1.post1 chromadb==0.4.24 sentence-transformers==2.5.1 pysqlite3-binary

# Cài đặt trình duyệt cho Playwright (dùng cho luồng crawler)
RUN playwright install --with-deps chromium

# Copy toàn bộ mã nguồn vào thư mục /app trong container
COPY . .

# Lệnh mặc định khởi chạy Scheduler
CMD ["python", "scheduler_service.py"]